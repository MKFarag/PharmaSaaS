    "IpPolicy": {
      "PermitLimit": 20,
      "WindowInSeconds": 60,
      "QueueLimit": 2
    },
    "UserPolicy": {
      "PermitLimit": 60,
      "WindowInSeconds": 60,
      "QueueLimit": 5
    },
    "SlidingWindow": {
      "PermitLimit": 60,
      "WindowInSeconds": 60,
      "SegmentsPerWindow": 6,
